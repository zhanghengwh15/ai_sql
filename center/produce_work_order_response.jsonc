        "planEndTime": null, // 计划结束时间，声明类型：Date；响应示例未返回，日期格式待实际响应确认
        "realBeginTime": null, // 实际开始时间，声明类型：Date；响应示例未返回，日期格式待实际响应确认
        "realEndTime": null, // 实际结束时间，声明类型：Date；响应示例未返回，日期格式待实际响应确认
        "auditStatus": null, // 审核状态，声明类型：Int；枚举：0=未审核，1=已审核；响应示例未返回
        "issueStatus": null, // 下发状态，声明类型：Int；枚举：0=未下发，1=已下发；响应示例未返回
        "executeStatus": null, // 执行状态，声明类型：Int；枚举：0=未开始，1=生产中，2=已完成，3=已取消，4=已关闭，5=已暂停；响应示例未返回
        "createTime": null, // 创建时间，声明类型：Date；响应示例未返回，日期格式待实际响应确认
        "modifyTime": null, // 更新时间，声明类型：Date；响应示例未返回，日期格式待实际响应确认
        "modifyByName": null, // 更新人账号（用户名），声明类型：String；响应示例未返回
        "auditTime": null, // 审核时间，声明类型：Date；响应示例未返回，日期格式待实际响应确认
        "auditByName": null, // 审核人账号（用户名），声明类型：String；响应示例未返回
        "issueTime": null, // 下发时间，声明类型：Date；响应示例未返回，日期格式待实际响应确认
